      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item) => {\n  const raw = item.json.text;\n  const clean = raw.replace(/```json|```/g, '').trim();\n  const parsed = JSON.parse(clean);\n\n  return {\n    json: {\n      ...item.json,\n      ...parsed\n    }\n  };\n});"
      },
