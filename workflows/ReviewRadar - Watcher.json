    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const reviews = data.reviews || [];\n  const businessName = data.place_info?.title || \"\";\n  const dataId = data.search_parameters?.data_id || \"\";\n\n  for (const r of reviews) {\n    output.push({\n      json: {\n        \"Business Name\": businessName,\n        \"Business Data ID\": dataId,\n        \"Reviewer Name\": r.user?.name ?? \"\",\n        \"Rating\": r.rating ?? null,\n        \"Review Text\": r.snippet ?? \"\",\n        \"Date\": r.iso_date ? r.iso_date.slice(0, 10) : (r.date ?? \"\"),\n        \"Review ID\": r.review_id ?? \"\"\n      }\n    });\n  }\n}\n\nreturn output;"
      },
