        "jsCode": "const existingIds = new Set(\n  $('All Reviews Read').all()\n    .map(item => item.json[\"Review ID\"])\n    .filter(Boolean)\n);\n\nreturn $input.all().filter(item => {\n  const id = item.json[\"Review ID\"];\n  return id && !existingIds.has(id);\n});"
      },
