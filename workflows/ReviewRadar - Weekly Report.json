    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nconst groupMap = {};\n\nfor (const row of rows) {\n  const business = row[\"Business Name\"] || \"Unknown Business\";\n  if (!groupMap[business]) {\n    groupMap[business] = [];\n  }\n  groupMap[business].push(row);\n}\n\nconst businessSummaries = Object.entries(groupMap).map(([business, items]) => {\n  const avgRating =\n    items.reduce((sum, r) => sum + (Number(r[\"Rating\"]) || 0), 0) / items.length;\n\n  const summaryText = items.map(r => {\n    return `- ${r[\"Reviewer Name\"]} | ${r[\"Rating\"]} stars | ${r[\"Review Text\"]} | ${r[\"Date\"]}`;\n  }).join(\"\\n\");\n\n  return {\n    business_name: business,\n    total_reviews: items.length,\n    avg_rating: Number(avgRating.toFixed(2)),\n    summary_text: summaryText,\n    rows: items\n  };\n});\n\nreturn [{\n  json: {\n    total_reviews: rows.length,\n    business_summaries: businessSummaries\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
