      "name": "Summarize \"All Reviews\""
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || \"\";\nconst clean = raw.replace(/```json|```/g, \"\").trim();\nconst parsed = JSON.parse(clean);\n\nreturn [{\n  json: parsed\n}];"
      },
